# Copy this file to .env and fill in real values. Never commit .env.
# These are placeholder variable names only — no real secrets.

# ---- Flask backend ----
FLASK_ENV=development
FLASK_SECRET_KEY=changeme
FLASK_DEBUG=1

# ---- Database ----
DATABASE_URL=postgresql+psycopg://flowdesk:changeme@localhost:5432/flowdesk_dev
TEST_DATABASE_URL=postgresql+psycopg://flowdesk:changeme@localhost:5432/flowdesk_test
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ---- Sessions / CSRF ----
SESSION_COOKIE_SECURE=false
CSRF_SECRET_KEY=changeme

# ---- Redis / Celery ----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ---- CORS ----
FRONTEND_ORIGIN=http://localhost:5173

# ---- Object storage (S3-compatible) ----
S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- AI provider (swappable) ----
AI_PROVIDER=
AI_API_KEY=

# ---- Frontend (Vite) ----
VITE_API_BASE_URL=http://localhost:5000/api/v1
