# Copy this file to .env and fill in real values. Never commit .env.
# These are placeholder variable names only — no real secrets.

# ---- Flask backend ----
FLASK_ENV=development
FLASK_SECRET_KEY=changeme
FLASK_DEBUG=1

# ---- Database ----
DATABASE_URL=postgresql+psycopg://flowdesk:changeme@localhost:5432/flowdesk_dev
TEST_DATABASE_URL=postgresql+psycopg://flowdesk:changeme@localhost:5432/flowdesk_test
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ---- Docker Compose (Postgres + Redis containers — see docker-compose.yml) ----
# Must match the credentials/db names in DATABASE_URL / TEST_DATABASE_URL above
# if you point the app at the containers instead of a native install.
POSTGRES_USER=flowdesk
POSTGRES_PASSWORD=changeme
POSTGRES_DB=flowdesk_dev
POSTGRES_TEST_DB=flowdesk_test
# Change these if the default port is already taken on your machine
# (e.g. by a native Postgres/Redis install).
DB_HOST_PORT=5432
REDIS_HOST_PORT=6379

# ---- Sessions (FD-010) ----
# CSRF uses a per-session random token (app.auth.service.create_session),
# not a separate app-wide secret - no CSRF_SECRET_KEY needed.
SESSION_LIFETIME_DAYS=7
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=false
# Production (Render backend + Vercel frontend, FD-065) MUST override
# both: SESSION_COOKIE_SAMESITE=None (+ this true, + HTTPS, which
# ProductionConfig already defaults to) - the frontend and backend are
# different registrable domains there, so the local-dev defaults above
# would silently block the session cookie entirely. See
# backend/README.md's Deployment section.

# ---- Redis / Celery ----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ---- CORS (FD-065) ----
# Also used to build invitation email links (app/config.py's
# FRONTEND_URL). Required in production (startup raises RuntimeError if
# unset) - set to the real https://<project>.vercel.app URL there, or
# every cross-origin request from the real frontend is rejected.
FRONTEND_ORIGIN=http://localhost:5173

# ---- Invitation email delivery (FD-016) ----
# SMTP rather than a vendor SDK - works with any real provider's SMTP
# relay (or a local dev catcher like MailHog/Mailtrap) via the same
# code path. SMTP_HOST empty means "log instead of send" (dev default);
# required in production (see backend/app/__init__.py's startup check).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM_ADDRESS=no-reply@flowdesk.local
INVITATION_EXPIRY_DAYS=7

# ---- AI reporting service (FD-055/FD-059) ----
# Resolves Section 35 open decision #12: Anthropic Claude API, no
# hard per-report budget cap beyond a bounded ANTHROPIC_MAX_TOKENS +
# AI_REQUEST_TIMEOUT_SECONDS. Leave ANTHROPIC_API_KEY empty until
# you're ready to generate a real report - the FD-059 scheduled job
# (every Monday 06:00, each organization's own local time) will just
# log a failure for every organization it's due for, rather than
# crash, until this is set.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
AI_MAX_TOKENS=1024

# ---- Frontend (Vite) ----
# Leave unset in local dev - defaults to "/api/v1", which goes through
# the Vite dev-server proxy in vite.config.ts (same-origin from the
# browser's point of view, so the session cookie works without CORS
# changes on the backend - see frontend/src/api/client.ts). Only set
# this to an absolute URL for a deployment where the frontend isn't
# served through that proxy (e.g. a production build talking to a
# separately-hosted backend - see frontend/README.md).
VITE_API_BASE_URL=

# --- Cloudflare Turnstile (bot check on register + login) -------------
# Off when empty. Set the frontend site key and the backend secret
# together. For local testing, Cloudflare's public test keys always pass:
#   VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET=1x0000000000000000000000000000000AA
#   TURNSTILE_HOSTNAMES=example.com   (the hostname test keys report)
# (test-key results are refused when FLASK_ENV=production).
# Production: create a widget in the Cloudflare dashboard (Turnstile ->
# Add widget, mode Managed, your real domain), put its secret in your
# host's secret manager, and set TURNSTILE_HOSTNAMES to the exact
# frontend hostname(s) - never localhost.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=

# --- Cloudflare Web Analytics (frontend) -------------------------------
# Token of a Web Analytics site (dashboard -> Analytics & Logs -> Web
# Analytics -> Add a site). Empty = no beacon is loaded. Cookie-free.
VITE_CF_ANALYTICS_TOKEN=
